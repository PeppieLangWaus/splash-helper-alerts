# Environment Configuration Template
# Copy this to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=1234

# Join by joaoapps Configuration
# Get these from your Join app on your phone
JOIN_API_KEY=your_join_api_key_here
JOIN_DEVICE_ID=group.all
# group.all sends to all devices
# Or use a specific device ID like: device_abc123

# Account Filtering (Optional)
# Set to 'true' to enable filtering by player names
ACCOUNT_FILTER_ENABLED=false
# Comma-separated list of player names to alert on
# ACCOUNT_FILTER_NAMES=YourCharacter,AltName,IronmAN

# Event Filtering (Optional)
# Comma-separated list of event types to include (empty = all)
# Common types: DEATH, LEVEL, LOGIN, LOGOUT, LOOT, PET, SLAYER, etc.
# EVENT_FILTER=DEATH,LEVEL,LOGIN
EVENT_FILTER=

# Event Exclusion (Optional)
# Comma-separated list of event types to exclude
# EVENT_EXCLUDE=LOGIN,LOGOUT,COLLECTION
EVENT_EXCLUDE=

# Alert Processing
INCLUDE_SCREENSHOT=false
DEBUG=false

# Additional Security (Optional)
# If Dink is configured to send a secret, verify it here
# DINK_SECRET=your_secret_here
